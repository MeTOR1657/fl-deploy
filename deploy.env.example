# Project/domain
PROJECT_NAME=g13-web
SITE_DOMAIN=fsg13.cpecmu.com
FRONTEND_PORT=6013

# PostgreSQL (use long unique passwords; app password must be letters/numbers only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=campusfix
POSTGRES_APP_USER=campusfix_app
POSTGRES_APP_PASSWORD=replace_with_32_plus_random_letters_and_numbers

# Backend session signing key (at least 32 characters)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# OAuth credentials
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://fsg13.cpecmu.com/auth/google/callback

CMU_OAUTH_CLIENT_ID=replace_with_cmu_client_id
CMU_OAUTH_CLIENT_SECRET=replace_with_cmu_client_secret
CMU_OAUTH_REDIRECT_URI=https://fsg13.cpecmu.com/api/auth/callback

# Public site origin used by backend CORS and OAuth redirects
FRONTEND_URL=https://fsg13.cpecmu.com
